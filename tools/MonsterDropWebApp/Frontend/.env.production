# Production Environment Variables for Frontend

# API Configuration
VITE_API_BASE_URL=https://shaiya-monsterdrop-api.up.railway.app
VITE_SIGNALR_HUB_URL=https://shaiya-monsterdrop-api.up.railway.app/hubs/monsterdrop

# Application Configuration
VITE_APP_NAME=Shaiya Monster Drop Editor
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Web-based monster drop rate editor for Shaiya Episode 6

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false
VITE_ENABLE_DEV_TOOLS=false

# UI Configuration
VITE_DEFAULT_THEME=dark
VITE_ENABLE_THEME_TOGGLE=true

# Performance
VITE_ENABLE_PWA=true
VITE_ENABLE_OFFLINE_MODE=false